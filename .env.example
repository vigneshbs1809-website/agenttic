# Literature Intelligence Platform - Environment Configuration Example
# Copy this file to .env and adjust values as needed for your local environment.

# Application Settings
APP_NAME="Literature Intelligence Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000
DEBUG=True

# Database Paths (SQLite & ChromaDB)
DATABASE_URL="sqlite:///./backend/data/literature.db"
CHROMA_PERSIST_DIR="./backend/data/chromadb"
PDF_STORAGE_DIR="./backend/data/PDFs"

# Local Ollama Inference & Embedding Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_LLM_MODEL="qwen3:1.7b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=60

# Chunking & Retrieval Constraints (8 GB RAM Optimizations)
MAX_CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=5
LLM_CONTEXT_LENGTH=4096
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

